{
  "schemaVersion": 1,
  "id": "redstone_utils",
  "version": "${version}",
  "name": "Redstone Utils",
  "description": "Client and server tools for designing, inspecting, and debugging Redstone systems.",
  "authors": [
    "Redstone787"
  ],
  "contact": {
    "homepage": "https://github.com/Redstone787/RedstoneUtils",
    "sources": "https://github.com/Redstone787/RedstoneUtils",
    "issues": "https://github.com/Redstone787/RedstoneUtils/issues"
  },
  "license": "MPL-2.0",
  "icon": "assets/redstone_utils/icon.png",
  "environment": "*",
  "entrypoints": {
    "client": [
      "io.github.redstone787.redstone_utils.client.RedstoneUtilsClient"
    ],
    "main": [
      "io.github.redstone787.redstone_utils.RedstoneUtils"
    ]
  },
  "mixins": [
    "redstone_utils.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}"
  }
