  "name": "Redstone Labworks",
  "description": "Client and server tools for designing, inspecting, and debugging Redstone systems.",
  "authors": [
    "Redstone787"
  ],
  "contact": {
    "homepage": "https://github.com/Redstone787/RedstoneLabworks",
    "sources": "https://github.com/Redstone787/RedstoneLabworks",
    "issues": "https://github.com/Redstone787/RedstoneLabworks/issues"
  },
  "license": "MPL-2.0",
  "icon": "assets/redstonelabworks/icon.png",
  "environment": "*",
  "entrypoints": {
    "client": [
      "io.github.redstone787.redstonelabworks.client.RedstoneLabworksClient"
    ],
    "main": [
      "io.github.redstone787.redstonelabworks.RedstoneLabworks"
    ]
  },
  "mixins": [
    "redstonelabworks.mixins.json"
  ],
  "depends": {
